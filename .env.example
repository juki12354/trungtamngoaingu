# Local development. Production uses NODE_ENV=production behind HTTPS.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DB_PATH=data/center.sqlite
# Hosting: set DATABASE_URL in Render Environment to the Neon connection string.
# Keep SSL enabled (sslmode=verify-full); do not commit credentials.
# DATABASE_URL=
# First production start creates the Admin. Remove ADMIN_PASSWORD after setup.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
