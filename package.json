{
  "name": "vinh-english-center",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "lint": "eslint .",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "seed:classes": "node --env-file-if-exists=.env scripts/add-class-options.mjs",
